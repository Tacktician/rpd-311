# --- Node.js (reports-service) ---
node_modules/
services/*/node_modules/
npm-debug.log*
yarn-error.log*
coverage/

# --- Python (triage-service) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Go (status-service) ---
services/status-service/status-service
*.test
*.out

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Local infra state ---
.localstack/
pgdata/

# --- Terraform ---
# The main stack keeps state in S3 (see infra/terraform/versions.tf). The bootstrap
# stack keeps LOCAL state because it owns the bucket the main stack's state lives in —
# that file is account-specific and must not be committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
# Real variable values stay local; terraform.tfvars.example is committed.
terraform.tfvars
*.auto.tfvars
# .terraform.lock.hcl IS committed (pinned provider hashes for linux_amd64 + darwin_arm64).
!.terraform.lock.hcl

# --- Build output ---
dist/
build/

# --- Editors / OS ---
.DS_Store
*.swp
.vscode/
.idea/